PAGCOR_START_URL=https://www.pagcor.ph/regulatory/index.php
PAGCOR_MAX_PAGES=1000
PAGCOR_REQUEST_DELAY_SECONDS=0.2
PAGCOR_REQUEST_TIMEOUT_SECONDS=45
PAGCOR_FETCH_ATTEMPTS=3
PAGCOR_FINAL_SWEEP_ROUNDS=1
PAGCOR_FINAL_SWEEP_WAIT_SECONDS=30

# MeitY (meity.gov.in/documents) monitor - separate site, shares Telegram
# and GitHub Pages settings below with PAGCOR
MEITY_REQUEST_DELAY_SECONDS=0.3
MEITY_REQUEST_TIMEOUT_SECONDS=30
MEITY_FETCH_ATTEMPTS=3

# Optional Telegram delivery (shared by both monitors)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=

# Optional OCR fallback for scanned PDFs
PAGCOR_OCR_MIN_PAGE_CHARS=40
PAGCOR_OCR_DPI=180
PAGCOR_OCR_LANG=eng
